# Python (any component)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Node / Vite (any component)
node_modules/
dist/

# Runtime
logs/

# Live co-browse session recordings (runtime output, see GPU/backend/app/live_store.py).
# Calibration measurements alongside them are kept — they outlive sessions.
GPU/backend/sessions/*.jsonl

# twin-ui gallery build output
packages/twin-ui/dist-gallery/

# Browser smoke tests (scripts/smoke.sh): screenshots, server logs, Playwright output
e2e/artifacts/
e2e/test-results/
e2e/playwright-report/
# ...and Playwright's own default, when a run is started by hand from the repo root
/test-results/

# Static hosting (docs/STATIC_HOSTING.md): generated per-twin builds and the assembled site
dist-static/
/site/
