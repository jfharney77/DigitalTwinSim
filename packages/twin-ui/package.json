{
  "name": "@twinsim/twin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Dell clean-design tokens and the shell components every twin frontend reuses.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./skin.css": "./src/skin.css",
    "./shell.css": "./src/shell.css"
  },
  "scripts": {
    "gallery": "vite --config gallery/vite.config.ts",
    "build": "tsc --noEmit && vite build --config gallery/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
